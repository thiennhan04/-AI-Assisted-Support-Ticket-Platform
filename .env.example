# Local-only defaults. Copy this file to .env and change values when needed.
# Never reuse these credentials outside local development.

POSTGRES_PORT=5432
POSTGRES_SUPERUSER=platform_admin
POSTGRES_SUPERUSER_PASSWORD=local-postgres-admin
IDENTITY_DB_USER=identity_service
IDENTITY_DB_PASSWORD=local-identity-db
TICKET_DB_USER=ticket_service
TICKET_DB_PASSWORD=local-ticket-db
AI_DB_USER=ai_service
AI_DB_PASSWORD=local-ai-db
KNOWLEDGE_DB_USER=knowledge_service
KNOWLEDGE_DB_PASSWORD=local-knowledge-db

RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=platform
RABBITMQ_PASSWORD=local-rabbitmq

REDIS_PORT=6379
REDIS_PASSWORD=local-redis

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=platform-minio
MINIO_ROOT_PASSWORD=local-minio-secret
MINIO_BUCKET=knowledge

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana
