{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticket-platform.local/schemas/ticket.created.v1.schema.json",
  "title": "ticket.created.v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "producer",
    "correlationId",
    "tenantId",
    "subjectId",
    "schemaVersion",
    "data"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "ticket.created.v1" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "ticket-service" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "subjectId": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": 1 },
    "data": {
      "type": "object",
      "required": [
        "ticketId",
        "ticketNumber",
        "requesterId",
        "subject",
        "description",
        "createdAt",
        "contentVersion"
      ],
      "properties": {
        "ticketId": { "type": "string", "format": "uuid" },
        "ticketNumber": { "type": "string", "minLength": 1 },
        "requesterId": { "type": "string", "format": "uuid" },
        "subject": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "contentVersion": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
