{
  "info": {
    "name": "Ticket Platform - Local API Tests",
    "description": "Run requests in numbered order. Local demo data is required. Login responses, ticket ID and ETag are stored as collection variables. Exported variables may contain tokens; clear them before sharing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "identityUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "ticketUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "tenantCode",
      "value": "acme",
      "type": "string"
    },
    {
      "key": "password",
      "value": "ChangeMe123!",
      "type": "string"
    },
    {
      "key": "customerAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "agentAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "agentRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "createKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    },
    {
      "key": "originalTicketId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketEtag",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Identity health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{identityUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Ticket health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{ticketUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Login customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{identityUrl}}/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantCode\": \"{{tenantCode}}\",\n  \"email\": \"customer@acme.local\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set(\"customerAccessToken\", body.accessToken);",
              "  pm.collectionVariables.set(\"customerRefreshToken\", body.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Login agent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{identityUrl}}/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantCode\": \"{{tenantCode}}\",\n  \"email\": \"agent@acme.local\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.collectionVariables.set(\"agentAccessToken\", body.accessToken);",
              "  pm.collectionVariables.set(\"agentRefreshToken\", body.refreshToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Create ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{createKey}}"
          }
        ],
        "url": "{{ticketUrl}}/v1/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Cannot sign in\",\n  \"description\": \"The customer cannot sign in after resetting the password\",\n  \"priority\": \"HIGH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"createKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set(\"ticketId\", pm.response.json().id);",
              "  pm.collectionVariables.set(\"originalTicketId\", pm.response.json().id);",
              "}",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const etag = pm.response.headers.get(\"ETag\");",
              "  if (etag) pm.collectionVariables.set(\"ticketEtag\", etag);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Replay create with the same key",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{createKey}}"
          }
        ],
        "url": "{{ticketUrl}}/v1/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Cannot sign in\",\n  \"description\": \"The customer cannot sign in after resetting the password\",\n  \"priority\": \"HIGH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) {",
              "  pm.test(\"Same ticket returned\", function () {",
              "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"originalTicketId\"));",
              "  });",
              "}",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const etag = pm.response.headers.get(\"ETag\");",
              "  if (etag) pm.collectionVariables.set(\"ticketEtag\", etag);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Reject reused key with different body",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{createKey}}"
          }
        ],
        "url": "{{ticketUrl}}/v1/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Different request\",\n  \"description\": \"The customer cannot sign in after resetting the password\",\n  \"priority\": \"HIGH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Get ticket and current ETag",
